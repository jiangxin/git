# Platform specific Makefile tweaks based on uname detection

uname_S := $(shell sh -c 'uname -s 2>/dev/null || echo not')

ifeq ($(uname_S),Darwin)
	# Some gettext related test cases (such as t0204) expect to
	# get the locale other than "UTF-8" on macOS, but when
	# calling "locale_charset()“ from "libcharset.h", it will
	# always return "UTF-8" instead of the locale set in environment
	# "LC_ALL", "LC_CTYPE" or "LANG".
	#
	# Let's override "config.mak.autogen" by unset "HAVE_LIBCHARSET_H"
	# in order to use "nl_langinfo()" of "langinfo.h" to get locale.
	#
	HAVE_LIBCHARSET_H =
endif
